# Bharat Nyaya AI - Environment Variables Reference

# Server Port
PORT=5000
NODE_ENV=development

# Database Configuration
# Default: Zero-configuration local SQLite (Immediate demo ready out of the box)
DATABASE_URL="file:./dev.db"

# Optional PostgreSQL Configuration (Docker / Local Postgres service):
# DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/bharat_nyaya_db?schema=public"

# Authentication Secrets
JWT_SECRET="bharat_nyaya_super_secret_jwt_key_2025_college_proto"
JWT_EXPIRES_IN="24h"

# AI Investigation Intelligence Engine Mode
# "MOCK" = Deterministic, rich synthetic college demonstration mode
# "LIVE" = Integration mode with external LLM API
AI_MODE="MOCK"

# Storage Settings
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25

# Frontend CORS Origin
CORS_ORIGIN="http://localhost:5173"
